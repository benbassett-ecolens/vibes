# ---- Server ----
PORT=8080
NODE_ENV=development

# Postgres. Locally: a plain connection string.
# On Cloud Run: leave DATABASE_URL unset and set the three CLOUD_SQL_* values instead,
# the server then connects over the Cloud SQL unix socket.
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
# CLOUD_SQL_CONNECTION_NAME=my-project:us-central1:ecolens-crm
# DB_USER=crm
# DB_PASSWORD=change-me
# DB_NAME=crm

# ---- Auth ----
# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
# Only accounts in this Google Workspace domain may sign in.
ALLOWED_DOMAIN=ecolens.io
# Comma-separated emails that are admins on first login (others become members).
ADMIN_EMAILS=ben@ecolens.io
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs the session cookie.
SESSION_SECRET=dev-only-secret-change-me
# Session lifetime in hours.
SESSION_HOURS=72

# Local development only. Enables POST /api/auth/dev which signs you in as any
# ALLOWED_DOMAIN address without Google. Ignored when NODE_ENV=production.
AUTH_DEV_MODE=true
